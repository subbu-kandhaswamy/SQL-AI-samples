  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/mssql": "^9.1.7",
    "@types/node": "^16.7.13",
    "jest": "^29.7.0",
    "shx": "^0.3.4",
    "ts-jest": "^29.1.2",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@azure/identity": "^4.8.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^10.0.0",
    "mssql": "^11.0.1"
  },
  "type": "module"
}
